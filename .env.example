# =============================================================================
# IHSG Forecasting Engine - example environment file
# Salin menjadi .env lalu isi nilai rahasianya:
#   cp .env.example .env
# Generate secret dengan: openssl rand -hex 32
# =============================================================================

# --- Identitas run -----------------------------------------------------------
# as_of kosong = otomatis (hari bursa BEI terakhir yang sudah selesai).
# Format: YYYY-MM-DD
AS_OF=
START_DATE=2018-01-01
TICKERS=^JKSE,CL=F,GC=F,IDR=X,^HSI,^N225,^DJI,EEM

# Hari libur bursa BEI (comma separated). Isi dari kalender resmi BEI.
# Dipakai untuk kalender kerja, tanggal target forecast, dan DQ gap.
IDX_HOLIDAYS=

# --- Storage (medallion) -----------------------------------------------------
# SINK=local  -> filesystem di dalam container (untuk debugging cepat)
# SINK=s3     -> Garage / MinIO / Azure Blob (S3-compatible)
SINK=s3
LOCAL_ROOT=/app/state/data

S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Garage ------------------------------------------------------------------
GARAGE_CONN_HOST_PORT=3900
GARAGE_ADMIN_HOST_PORT=3903
GARAGE_WEBUI_HOST_PORT=3909
# 32 bytes sebagai 64 hex
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Bearer token untuk Admin API v2 (harus sama dengan GARAGE_ADMIN_TOKEN)
GARAGE_ADMIN_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_ADMIN_TOKEN=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_DEFAULT_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
GARAGE_DEFAULT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_BUCKETS=bronze silver gold mlartifacts

# --- Prefect -----------------------------------------------------------------
PREFECT_HOST_PORT=4200
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_SERVER_UI_API_URL=http://127.0.0.1:4200/api

# --- Model -------------------------------------------------------------------
SEED=42
WINDOW=22
HORIZONS=7
REFIT_EVERY=21
TRAIN_FRAC=0.60
VAL_FRAC=0.20
TAU_QUANTILE=0.95
FFILL_LIMIT=3
HIDDEN=32
LAYERS=1
DROPOUT=0.10
EPOCHS=120
BATCH_SIZE=32
LEARNING_RATE=0.003
WEIGHT_DECAY=0.0001
PATIENCE=15
RIDGE_ALPHA=1000.0
ML_GATE_ALPHA=0.05
EWMA_LAMBDA=0.94

# --- Serving -----------------------------------------------------------------
# LIVE_INFERENCE=0 -> Function/API hanya membaca gold (default, murah & deterministik)
# LIVE_INFERENCE=1 -> API menjalankan model saat request (butuh torch di Function)
LIVE_INFERENCE=0
ADMIN_TOKEN=ganti-token-ini
